# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.iml
.idea/

# Generated by `flutter gen-l10n` (see l10n.yaml, scripts/bootstrap-flutter.sh)
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Local CocoaPods install (see bundle config in Gemfile), not system-wide
.bundle/
vendor/bundle/

# Android
android/.gradle/
android/local.properties
android/**/gradle-wrapper.jar

# macOS
.DS_Store

# Local Flutter SDK checkout (see scripts/bootstrap-flutter.sh)
.tools/

# Local venv for scripts/generate_icon.py (Pillow), project-scoped
venv/

# Claude Code session-local state, not project config
.claude/scheduled_tasks.lock

# Python
__pycache__/
*.pyc

# Local signing (Apple Developer Team ID) — never committed
ios/Flutter/Signing.xcconfig
