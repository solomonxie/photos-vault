# Demo-mode credentials. Copy to .env.demo (gitignored) and fill in.
# `make build` / `install-ios` pass it as --dart-define-from-file; `archive`
# and `release` never do, and fail if a value turns up in the binary. Only
# demo mode reads it, seeding the demo keychain (demo.* keys). Compiled
# into the build: use a throwaway bucket/key.

# Bucket: provider is one of s3, tencentCos, aliyunOss
DEMO_S3_PROVIDER=s3
DEMO_S3_REGION=us-west-2
DEMO_S3_BUCKET=
DEMO_S3_PREFIX=photos-vault-demo/
DEMO_S3_ACCESS_KEY_ID=
DEMO_S3_SECRET_ACCESS_KEY=

# AI: vendor is one of openai, anthropic, google, groq, mistral, xai
DEMO_AI_VENDOR=openai
DEMO_AI_API_KEY=
